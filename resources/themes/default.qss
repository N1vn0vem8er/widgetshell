BarWidget {
    background-color: #100043;
}

WorkspaceButton {
    background-color: #38427f;
}

WorkspaceButton:hover {
    background-color: #6474e1;
}

WorkspaceButton:checked {
    background-color: #b0b9e1;
}

ControlMenu {
    background-color: #100043;
}

ControlMenu QPushButton {
    background-color: #38427f;
    border: none;
    border-radius: 4px;
    height: 35px;
}

ControlMenu QPushButton:hover {
    background-color: #6474e1;
}

ControlMenu QPushButton:checked {
    background-color: #b0b9e1;
}

ControlMenuButton {
    background-color: #38427f;
}

ControlMenuButton:hover {
    background-color: #6474e1;
}

ControlMenuButton:checked {
    background-color: #b0b9e1;
}

AudioVolumeControlComponent {
    background-color: #063b5c;
    border: 1px solid #0a5a82;
    border-radius: 10px;
}

AudioVolumeControlComponent QPushButton {
    width: 35px;
    background-color: #0b4d70;
    color: #d9f3ff;
    border: none;
    border-radius: 8px;
}

AudioVolumeControlComponent QComboBox {
    background-color: #0b4d70;
}

AudioVolumeControlComponent QPushButton:hover {
    background-color: #0d638f;
}

AudioVolumeControlComponent QPushButton:pressed {
    background-color: #08415f;
}

AudioVolumeControlComponent QSlider::groove:horizontal {
    background-color: #082c43;
    border-radius: 3px;
}

AudioVolumeControlComponent QSlider::sub-page:horizontal {
    background-color: #18aee6;
    border-radius: 3px;
}

AudioVolumeControlComponent QSlider::add-page:horizontal {
    background-color: #0a3048;
    border-radius: 3px;
}

AudioVolumeControlComponent QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    background-color: #6dd5fa;
    border: none;
    border-radius: 7px;
}

AudioVolumeControlComponent QSlider::handle:horizontal:hover {
    background-color: #9be7ff;
}

CpuUsageComponent {
    background-color: #355436;
    border: none;
    border-radius: 4px;
}

MemoryUsageComponent {
    background-color: #05a182;
    border: none;
    border-radius: 4px;
}

DateTimeComponent {
    background-color: #460194;
    border: none;
    border-radius: 4px;
}

NetworkConnectionComponent {
    background-color: #005b94;
    border: none;
    border-radius: 4px;
}

#NetworkConnectionComponentButton:hover {
    background-color: #6474e1;
    border: none;
    border-radius: 4px;
}

NetworkMenu {
    background-color: #100043;
}

NetworkMenu QScrollBar:horizontal {
    background: #100043;
    height: 10px;
}

NetworkMenu QScrollBar::handle:horizontal {
    background: #5b3fbf;
    min-width: 30px;
    border-radius: 5px;
}

NetworkMenu QScrollBar::handle:horizontal:hover {
    background: #7956e8;
}

NetworkMenu QScrollBar::add-line:horizontal,
NetworkMenu QScrollBar::sub-line:horizontal {
    height: 0px;
}

NetworkMenu QScrollBar::add-page:horizontal,
NetworkMenu QScrollBar::sub-page:horizontal {
    background: #1b0757;
}

NetworkMenu QScrollBar:vertical {
    background: #100043;
    width: 10px;
    margin: 0px;
}

NetworkMenu QScrollBar::handle:vertical {
    background: #5b3fbf;
    min-height: 30px;
    border-radius: 5px;
}

NetworkMenu QScrollBar::handle:vertical:hover {
    background: #7956e8;
}

NetworkMenu QScrollBar::add-line:vertical,
NetworkMenu QScrollBar::sub-line:vertical {
    height: 0px;
}

NetworkMenu QScrollBar::add-page:vertical,
NetworkMenu QScrollBar::sub-page:vertical {
    background: #1b0757;
}

#NetworkMenuInterfaceButton {
    background-color: transparent;
}

AudioVolumeControlBarComponent {
    background-color: #547557;
    border: none;
    border-radius: 4px;
    padding: 8px;
}

AudioVolumeControlBarComponent:hover {
    background-color: #547f57;
}

NotificationPopupComponent {
    background-color: #100043;
}

DiskUsageBarComponent {
    background-color: #7956e8;
    border: none;
    padding: 8px;
    border-radius: 5px;
}

DiskUsageBarComponent:hover {
    background-color: #7956ff;
}

NotificationHistoryComponent {
    background-color: #063b5c;
    border: 1px solid #0a5a82;
    border-radius: 10px;
}

NotificationHistoryComponent QListWidget {
    background-color: #063b5c;
    border: 0px solid #063b5c;
}

NotificationHistoryComponent QLineEdit {
    background-color: #0b4d70;
}